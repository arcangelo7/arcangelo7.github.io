// @ts-ignore - virtual module resolved by Starlight at runtime
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;

function reverseEntries(entries: any[]): any[] {
	const indexEntry = entries.find(e => e.label === 'index');
	const otherEntries = entries.filter(e => e !== indexEntry);

	otherEntries.reverse();

	return indexEntry ? [indexEntry, ...otherEntries] : otherEntries;
}

function reverseGroup(group: any): any {
	if (!group.entries) return group;
	return { ...group, entries: reverseEntries(group.entries).map(reverseGroup) };
}

const reversedSidebar = sidebar.map(reverseGroup);
---
<SidebarPersister>
	<SidebarSublist sublist={reversedSidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
